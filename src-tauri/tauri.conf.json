{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "711EV-Codex-Tool",
  "version": "0.1.64",
  "identifier": "com.codexlocalsync.desktop",
  "build": {
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "711EV-Codex-Tool",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Replicate local Codex sessions across Providers",
    "longDescription": "A portable desktop tool that creates independent Codex Thread replicas under the current Provider while preserving source sessions."
  }
}
