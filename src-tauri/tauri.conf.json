{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT中转工具",
  "mainBinaryName": "711EV-Codex-Tool",
  "version": "1.1.8",
  "identifier": "com.codexlocalsync.desktop",
  "build": {
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "ChatGPT中转工具",
        "width": 385,
        "height": 698,
        "minWidth": 352,
        "minHeight": 637,
        "maxWidth": 452,
        "maxHeight": 826,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "711EV",
    "homepage": "https://www.711ev.com/",
    "category": "DeveloperTool",
    "shortDescription": "Replicate local Codex sessions across Providers",
    "longDescription": "A portable desktop tool that creates independent Codex Thread replicas under the current Provider while preserving source sessions.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNzYyQjc2NzVENUE4QjQKUldTMHFOVjFkaXQyc1ZKY1hORUZyc01SNGdnemExdytQaHBleXV0M1cvTDdoVEJIRm1QOVdjN0oK",
      "endpoints": [
        "https://github.com/711EV/711EV-Codex-Tool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
