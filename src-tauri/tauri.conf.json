        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNzYyQjc2NzVENUE4QjQKUldTMHFOVjFkaXQyc1ZKY1hORUZyc01SNGdnemExdytQaHBleXV0M1cvTDdoVEJIRm1QOVdjN0oK",
      "endpoints": [
        "https://github.com/711EV/711EV-Codex-Tool/releases/latest/download/latest.json"
      ],
