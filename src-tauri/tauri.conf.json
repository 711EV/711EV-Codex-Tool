{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Local Sync",
  "version": "0.1.0",
  "identifier": "com.codexlocalsync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Local Sync",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "category": "DeveloperTool",
    "shortDescription": "Synchronize local Codex sessions between profiles",
    "longDescription": "A portable desktop tool for synchronizing local Codex project sessions between ChatGPT accounts and custom API profiles."
  }
}
