{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "711EV-Codex-Tool",
  "mainBinaryName": "711EV-Codex-Tool",
  "version": "0.1.70",
  "identifier": "com.codexlocalsync.desktop",
  "build": {
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "711EV-Codex-Tool",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
